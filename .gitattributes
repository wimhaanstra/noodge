# Normalise line endings in the repository to LF.
* text=auto eol=lf

*.go   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf

# Shell scripts MUST be LF. A CRLF install.sh fails `curl … | sh` with an
# error that names entirely the wrong problem.
*.sh   text eol=lf

# PowerShell scripts are CRLF; PS 5.1 is happier with them.
*.ps1  text eol=crlf

# Never touch binaries.
*.png  binary
*.ico  binary
*.exe  binary
*.zip  binary
*.gz   binary
